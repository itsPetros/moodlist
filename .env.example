# YouTube Data API v3 key (see README, step 2). Without it the app still works,
# but songs show as "Search on YouTube" links instead of playing in the page.
YOUTUBE_API_KEY=paste_your_key_here

# Countries where a video must be playable to be used. Use the countries of the
# people who will use the app (2-letter codes, comma separated). A video blocked in
# one of them is skipped, which avoids "Video unavailable" in the player.
YOUTUBE_REGION=AM,US

# Optional settings (defaults shown)
REPORT_THRESHOLD=2
MIN_VIEWS=1000000
DAILY_UNIT_BUDGET=9000
LAZY_RESOLVE_PER_REQUEST=3
RATE_LIMIT_PER_MIN=30

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
SECRET_KEY=generate-with-python-secrets-token_urlsafe-48
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com